{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@nexus/db": ["./db/ts/src/index.ts"],
      "@nexus/db/*": ["./db/ts/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    ".next/types/**/*.ts",
    "test/**/*"
  ]
}

