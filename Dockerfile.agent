FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy database shared library and agent orchestrator code
COPY db/py /app/db/py
COPY nexus-agent /app/nexus-agent

# Install dependencies and packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir /app/db/py && \
    pip install --no-cache-dir /app/nexus-agent

WORKDIR /app/nexus-agent

EXPOSE 8080

CMD ["sh", "-c", "uvicorn nexus_agent.api.server:app --host 0.0.0.0 --port ${PORT:-8080}"]

